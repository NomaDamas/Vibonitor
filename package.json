{
  "name": "vibonitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first project context, roadmap and idea cockpit for coding agents",
  "bin": {
    "vibonitor": "./dist/cli.js"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server.ts\" \"vite\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.app.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
